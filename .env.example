# Filter status task (custom): probe each candidate IP against FILTER_PROBE_URL and
# keep only those answering an accepted HTTP status code (default: 200). For
# the real origin path, point it at your own domain. FILTER_ACCEPT_STATUS
# supports single codes, ranges, and comma combinations (200, 200-299, 200,301,
# or any). Defaults: https://speed.cloudflare.com, 200, 5s timeout, 20 parallel probes.
FILTER_PROBE_URL=https://speed.cloudflare.com
FILTER_ACCEPT_STATUS=200
# When no IP matches FILTER_ACCEPT_STATUS, write an empty result.csv instead
# of keeping the previous one (default: false).
FILTER_ALLOW_EMPTY=false
# FILTER_TIMEOUT=5
# FILTER_CONCURRENCY=20
# FILTER_PROBE_ROWS=200
# FILTER_OUTPUT_LIMIT=10

# GitHub Configuration
DISPATCH_TOKEN=your_github_pat_token_here
DISPATCH_OWNER=your_github_username
DISPATCH_REPO=your_repo_name
DISPATCH_WORKFLOW=main.yml
DISPATCH_REF=main
# Optional: Workflow dispatch inputs (JSON format)
DISPATCH_INPUTS='{"environment":"production","deploy_type":"full"}'
